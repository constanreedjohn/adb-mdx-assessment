# -----------------------------------------------------------------------------
# Third-party service configuration
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the template.
# Real environment variables always take precedence over values in `.env`.
# Read by src/mdx_assessment/settings.py (pydantic-settings, no load_dotenv()).
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# Versioned configuration directory (playbooks, profiles, manifests, prompts).
# Defaults to <project root>/config; uncomment only to point elsewhere.
# MDX_CONFIG_DIR=/absolute/path/to/config
# Local data (simulated days in <data dir>/sim/<date>/). Defaults to <project root>/data.
# MDX_DATA_DIR=/absolute/path/to/data
# Where secrets come from: env (this file / environment variables) or key_vault
# (Azure Key Vault via AZURE_KEY_VAULT_URL; not implemented until E13-04).
MDX_SECRETS_BACKEND=env
# Label on traces (Langfuse environment): local, ci, poc, ...
MDX_ENVIRONMENT=local
# Model behind the LLM gateway: azure_openai, or fake (scripted replies; CI and offline work)
MDX_LLM_PROVIDER=azure_openai

# --- Azure OpenAI (LLM gateway) ---------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# api_key | entra   (entra uses Managed Identity / az login via azure-identity)
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Optional: per-call timeout (seconds) and retries at the HTTP client level
AZURE_OPENAI_TIMEOUT_SECONDS=60
AZURE_OPENAI_MAX_RETRIES=2

# --- PostgreSQL (cases store, audit trail, LangGraph checkpoints) -----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mdx_assessment
POSTGRES_USER=mdx
POSTGRES_PASSWORD=mdx

# --- Langfuse Cloud (traces, tokens) ----------------------------------------
# PoC uses Langfuse Cloud (free tier). Host must match your project's region:
#   EU: https://cloud.langfuse.com    US: https://us.cloud.langfuse.com
# Keys: Langfuse project → Settings → API Keys. Tracing is skipped while unset.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# --- MLflow (ML platform stand-in, used from SP7) ---------------------------
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Azure platform (optional until deployment into ADB's tenant) -----------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
