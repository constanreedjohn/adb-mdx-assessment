# -----------------------------------------------------------------------------
# Third-party service configuration
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the template.
# Real environment variables always take precedence over values in `.env`.
# Read by src/mdx_assessment/settings.py (pydantic-settings, no load_dotenv()).
# -----------------------------------------------------------------------------

# --- Azure OpenAI (LLM gateway) ---------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# api_key | entra   (entra uses Managed Identity / az login via azure-identity)
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Optional: per-call timeout (seconds) and retries at the HTTP client level
AZURE_OPENAI_TIMEOUT_SECONDS=60
AZURE_OPENAI_MAX_RETRIES=2

# --- PostgreSQL (cases store, audit trail, LangGraph checkpoints) -----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mdx_assessment
POSTGRES_USER=mdx
POSTGRES_PASSWORD=mdx

# --- Langfuse (traces, tokens) ----------------------------------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# --- MLflow (ML platform stand-in, used from SP7) ---------------------------
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Azure platform (optional until deployment into ADB's tenant) -----------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
